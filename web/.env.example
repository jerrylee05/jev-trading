# Base URL of the Jev Trader backend (no trailing slash).
# The app connects to $NEXT_PUBLIC_API_URL/events (SSE).
# Local paper desk: trader on PORT=3010, this Next app on 3001.
NEXT_PUBLIC_API_URL=http://127.0.0.1:3010
